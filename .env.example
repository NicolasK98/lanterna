# Copia questo file in .env e modificalo:  cp .env.example .env

# Porta esposta sull'host
LANTERNA_PORT=8081

# Protezione accesso:
#   device = abbinamento dispositivi (consigliato): codice al primo accesso, poi il dispositivo è ricordato
#   none   = nessuna protezione (solo se la rete è totalmente fidata)
AUTH_MODE=device

# Codice di abbinamento fisso (almeno 8 caratteri). Se vuoto, ne viene generato uno a ogni avvio
# e lo trovi con: docker logs lanterna
PAIRING_CODE=

# Per quanti giorni un dispositivo inattivo resta abbinato
DEVICE_TTL_DAYS=400

# Etichette dei dischi (percorso sull'host = nome visualizzato), separate da virgola
DISK_LABELS=/=SSD Sistema,/mnt/storage=HDD Dati

# Mostra i pulsanti per riavviare/spegnere il server host
POWER_ACTIONS=true

# Dietro un reverse proxy (Caddy, Nginx Proxy Manager...): numero di proxy, "true"
# oppure IP/subnet fidati (es. 172.16.0.0/12). Lascia vuoto se accedi direttamente.
TRUST_PROXY=

# Controlla su GitHub se esiste una versione più recente
UPDATE_CHECK=true

# Fuso orario per gli orari nei log
TZ=Europe/Rome
